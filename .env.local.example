# =========================================================================
# Analytics
# =========================================================================
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# =========================================================================
# Whop — Embedded checkout for the 47€ LT course
# =========================================================================

# Server-side API key (Whop Dashboard → Developers → API keys).
# Used to create checkout_configurations with UTM/IG metadata attached.
WHOP_API_KEY=

# Revo company ID on Whop. Already known.
WHOP_COMPANY_ID=biz_oRDFEVPcVBjVmF

# The plan ID for the 47€ LT course.
# Find it: Whop dashboard → Checkout Links → three-dot menu → Details.
# Shape: plan_XXXXXXXXX
WHOP_LT_PLAN_ID=

# Public copy of the plan ID. Not currently used by the embed (we mint
# a server-side session with metadata instead), but kept here for the
# fallback hosted-checkout link and future experiments.
NEXT_PUBLIC_WHOP_LT_PLAN_ID=

# Standard Webhooks signing secret — set on the receiving app
# (revo-lab-portal /api/webhooks/whop). Not required on the LP itself.
WHOP_WEBHOOK_SECRET=
